<?xml version="1.0" encoding="utf-8"?>
<!--
  AirDraw talks to a Gateway that is running inside AirDraw.

  `EmbeddedAndroidAmboKitHost` starts the AmboKit Gateway in-process and binds it to loopback, so
  the app's own HTTP and WebSocket traffic goes to http://127.0.0.1:8787 and ws://127.0.0.1:8787.
  Cleartext to loopback has been blocked by default since API 28, which makes the very first call
  - POST /session - fail with an IOException before it leaves the device. The app reports that as
  "Unable to create Ambo session" with no HTTP code, because there was no response to take one
  from.

  The LAN address in the join URL and the QR code does not need permitting here: the Companion
  dials in to a socket this app is listening on, and this policy governs outbound requests.

  Scoped to loopback rather than turning cleartext on for the whole app, which is what a blanket
  android:usesCleartextTraffic="true" does. This is an app headed for a store, and "permits
  unencrypted traffic to anywhere" is a thing a reviewer reads as a finding rather than a
  configuration.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
